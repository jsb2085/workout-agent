# Postgres (used by the API container; compose overrides the host to `db`)
DATABASE_URL=postgresql+asyncpg://workout:workout@localhost:5432/workout

# JWT issued after Google Sign-In
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Google OAuth client ID from the iOS (and optional Web) OAuth client
GOOGLE_CLIENT_ID=your-ios-or-web-client-id.apps.googleusercontent.com

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=physique-photos
MINIO_SECURE=false

# Shared secret the LangChain / MCP client must send as Bearer token
MCP_AGENT_TOKEN=change-me-mcp-agent-token

CORS_ORIGINS=*
