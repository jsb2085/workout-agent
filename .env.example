MCP_AGENT_TOKEN=change-me-mcp-agent-token

# ExerciseDB demonstration videos. Empty key uses the free GIF host.
EXERCISEDB_API_KEY=
EXERCISEDB_API_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com
EXERCISEDB_BASE_URL=
EXERCISEDB_TIMEOUT_SECONDS=15

# Notion is the workout source of truth.
# 1. Create an internal integration: https://www.notion.so/my-integrations
# 2. Share one Notion page with the integration, then:
#    python3 workout setup --parent "https://www.notion.so/your-page-...." --write-env
#    (or import the CSVs in notion/csv — see notion/README.md)
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_LIFTS_DATABASE_ID=
NOTION_LOGS_DATABASE_ID=
NOTION_GOALS_DATABASE_ID=
NOTION_LOCATIONS_DATABASE_ID=
NOTION_STATS_DATABASE_ID=
NOTION_TEMPLATE_ID=
NOTION_DATA_SOURCE_ID=
NOTION_TIMEOUT_SECONDS=20

# LangGraph planner (OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

CORS_ORIGINS=*
