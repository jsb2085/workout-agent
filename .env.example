# Postgres (used by the API container; compose overrides the host to `db`)
DATABASE_URL=postgresql+asyncpg://workout:workout@localhost:5432/workout

# JWT issued after email/password login
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=physique-photos
MINIO_SECURE=false

# Shared secret the LangChain / MCP client must send as Bearer token
MCP_AGENT_TOKEN=change-me-mcp-agent-token

# ExerciseDB demonstration videos (RapidAPI). Leave the key empty to use the
# free hosted API (animated GIFs). A V2 key returns MP4 video_url values.
EXERCISEDB_API_KEY=
EXERCISEDB_API_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com
# Optional override. Empty uses RapidAPI when a key is set, otherwise https://oss.exercisedb.dev
EXERCISEDB_BASE_URL=
EXERCISEDB_TIMEOUT_SECONDS=15

CORS_ORIGINS=*
